{
  "name": "deployhub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n API,WEB -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev -- --host 0.0.0.0",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}