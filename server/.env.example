NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/deployhub
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_48
DEPLOYMENT_DOMAIN=
DEPLOYMENT_PROTOCOL=http
DEPLOYMENT_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32
DEPLOYMENT_DOCKER_NETWORK=deployhub_deployments
DEPLOYMENT_NGINX_CONTAINER=deployhub-nginx
DEPLOYMENT_NGINX_CONFIG_DIR=/deployment-nginx
